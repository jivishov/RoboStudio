OPENAI_API_KEY=

# Optional local advanced CAD backend. Point to a Python executable with
# requirements-cad.txt installed when build123d STEP export is needed.
ROBOSTUDIO_CAD_PYTHON=

# Optional Supabase settings for cloud part-library sync.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PART_LIBRARY_TABLE=part_library_items

# Optional auth behavior overrides.
VITE_AUTH_STORAGE_KEY=robotic-arm-studio.auth
VITE_AUTH_CALLBACK_PATH=/auth-callback.html
VITE_AUTH_RETURN_PATH=/parts.html
VITE_GOOGLE_OAUTH_PROMPT=select_account
VITE_AUTH_OPERATION_TIMEOUT_MS=20000
VITE_AUTH_LOCAL_CANONICAL_HOST=127.0.0.1
VITE_AUTH_ENFORCE_LOCAL_ORIGIN=true
